// Edit distance: the fewest insertions, deletions and replacements that
// turn one string into another, by dynamic programming over two rows.
// The strings are made of four letters, from the shared generator.
//
//     wind run main.wind test|bench

const int MAX = 6000

char a[MAX]
char b[MAX]
int previous[MAX + 1]
int current[MAX + 1]

int seed = 42

int random() {
    seed = seed * 48271 % 2147483647
    return seed
}

int distance(int n) {
    for (int j = 0; j <= n; j++) previous[j] = j
    for (int i = 1; i <= n; i++) {
        current[0] = i
        for (int j = 1; j <= n; j++) {
            int cost = a[i - 1] == b[j - 1] ? 0 : 1
            int best = previous[j - 1] + cost
            if (previous[j] + 1 < best) best = previous[j] + 1
            if (current[j - 1] + 1 < best) best = current[j - 1] + 1
            current[j] = best
        }
        for (int j = 0; j <= n; j++) previous[j] = current[j]
    }
    return previous[n]
}

int main(int argc, string argv[]) {
    int n = argc > 1 && argv[1] == "bench" ? MAX : 300
    for (int i = 0; i < n; i++) a[i] = char(97 + random() % 4)
    for (int i = 0; i < n; i++) b[i] = char(97 + random() % 4)
    cout << distance(n) << "\n"
    return 0
}
