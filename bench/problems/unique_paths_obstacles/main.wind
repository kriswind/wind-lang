// Unique paths with obstacles: the number of paths, modulo a prime, from
// the top-left corner of a grid to the bottom-right one, moving only right
// or down and never onto an obstacle. The table is one row: a cell's count
// is the count above it (still in the row) plus the count to its left. The
// grid is generated row by row with one number per cell from the shared
// generator; a cell is an obstacle when its number is a multiple of 10,
// except for the two corners, which are always open. Prints the number of
// paths and of obstacles.
//
//     wind run main.wind test|bench

const int MAX = 5000
const int PRIME = 1000000007

int paths[MAX]

int seed = 42

int random() {
    seed = seed * 48271 % 2147483647
    return seed
}

int main(int argc, string argv[]) {
    int size = argc > 1 && argv[1] == "bench" ? MAX : 120
    int rows = size
    int columns = size
    int obstacles = 0
    for (int j = 0; j < columns; j++) paths[j] = 0
    for (int i = 0; i < rows; i++) {
        for (int j = 0; j < columns; j++) {
            bool corner = i == 0 && j == 0 || i == rows - 1 && j == columns - 1
            bool blocked = random() % 10 == 0 && !corner
            if (blocked) {
                obstacles++
                paths[j] = 0
            } else if (i == 0 && j == 0) {
                paths[j] = 1
            } else if (j > 0) {
                int total = paths[j] + paths[j - 1]
                if (total >= PRIME) total -= PRIME
                paths[j] = total
            }
        }
    }
    cout << "paths " << paths[columns - 1] << "\n"
    cout << "obstacles " << obstacles << "\n"
    return 0
}
