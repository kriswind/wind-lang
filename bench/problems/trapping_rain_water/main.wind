// Trapping rain water: how much water a row of random column heights (from
// 0 to 999) holds after rain, by two pointers that walk in from both ends.
// The lower side moves inwards: its water level is set by the highest
// column seen on that side, because the other side is known to be higher.
//
//     wind run main.wind test|bench

const int MAX = 10000000

int heights[MAX]

int seed = 42

int random() {
    seed = seed * 48271 % 2147483647
    return seed
}

int trapped(int n) {
    int left = 0
    int right = n - 1
    int leftMax = 0
    int rightMax = 0
    int water = 0
    while (left < right) {
        if (heights[left] < heights[right]) {
            if (heights[left] >= leftMax) leftMax = heights[left]
            else water += leftMax - heights[left]
            left++
        } else {
            if (heights[right] >= rightMax) rightMax = heights[right]
            else water += rightMax - heights[right]
            right--
        }
    }
    return water
}

int main(int argc, string argv[]) {
    int n = argc > 1 && argv[1] == "bench" ? MAX : 1000
    for (int i = 0; i < n; i++) heights[i] = random() % 1000
    cout << trapped(n) << "\n"
    return 0
}
