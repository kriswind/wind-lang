// Two sum: counts the pairs i < j of n random values (from 0 to n - 1)
// whose sum is n, and how many distinct values there are. One pass: each
// value first looks up how many earlier values complete it, then adds itself
// to a hash table of counts. The table is open addressing with linear
// probing, its size a power of two at least twice n.
//
//     wind run main.wind test|bench

const int MAX = 2000000
const int SLOTS = 4194304

int values[MAX]
int keys[SLOTS]
int counts[SLOTS]
int mask = 0

int seed = 42

int random() {
    seed = seed * 48271 % 2147483647
    return seed
}

// The slot holding key, or the empty slot (key -1) where it would go.
int slot(int key) {
    int at = (key * 2654435761) & mask
    while (keys[at] != -1 && keys[at] != key) at = (at + 1) & mask
    return at
}

int main(int argc, string argv[]) {
    int n = argc > 1 && argv[1] == "bench" ? MAX : 1000
    int size = 1
    while (size < 2 * n) size *= 2
    mask = size - 1
    for (int i = 0; i < size; i++) keys[i] = -1
    for (int i = 0; i < n; i++) values[i] = random() % n
    int pairs = 0
    int distinct = 0
    for (int i = 0; i < n; i++) {
        int value = values[i]
        int want = n - value
        int at = slot(want)
        if (keys[at] == want) pairs += counts[at]
        at = slot(value)
        if (keys[at] != value) {
            keys[at] = value
            distinct++
        }
        counts[at]++
    }
    cout << pairs << " pairs, " << distinct << " distinct values\n"
    return 0
}
