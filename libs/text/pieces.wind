// Part of ::text: taking strings apart and putting them together. The
// pieces that split and trim give are views of the string they are given,
// and need nothing freed.

import chars
import search

// Appends to into the parts of s that lie between each sep, in order, empty
// ones included. With sep empty, appends the runs of characters between
// spaces instead, leaving out empty ones, as Python's split() does.
export void split(string s, string sep, string into[..]) {
    if (len(sep) == 0) {
        int start = -1
        for (int i = 0; i <= len(s); i++) {
            bool space = i == len(s) || chars.is_space(s[i])
            if (space && start >= 0) {
                append(into, s[start:i])
                start = -1
            } else if (!space && start < 0) {
                start = i
            }
        }
        return
    }
    int from = 0
    while (true) {
        int at = search.index_of(s[from:], sep)
        if (at < 0) break
        append(into, s[from:from + at])
        from += at + len(sep)
    }
    append(into, s[from:])
}

// s without the spaces, tabs and line breaks at either end.
export string trim(string s) {
    int start = 0
    int end = len(s)
    while (start < end && chars.is_space(s[start])) start++
    while (end > start && chars.is_space(s[end - 1])) end--
    return s[start:end]
}

// Appends the parts to into, with sep between each two.
export void join(char into[..], string parts[], string sep) {
    for (int i, string part in parts) {
        if (i > 0) append(into, sep)
        append(into, part)
    }
}

// Appends s to into, with each place where old appears replaced by
// replacement.
export void replace(char into[..], string s, string old, string replacement) {
    if (len(old) == 0) {
        append(into, s)
        return
    }
    int from = 0
    while (true) {
        int at = search.index_of(s[from:], old)
        if (at < 0) break
        append(into, s[from:from + at], replacement)
        from += at + len(old)
    }
    append(into, s[from:])
}
