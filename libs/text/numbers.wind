// Part of ::text: reading numbers out of strings.

import chars

// Reads s as a whole number in decimal, with an optional sign. Stores it
// in *value and returns true if all of s is one, and if it fits in an int,
// whose size depends on the target; returns false, leaving *value as it
// was, otherwise.
export bool parse_int(string s, int *value) {
    int at = 0
    bool negative = false
    if (len(s) > 0 && (s[0] == '-' || s[0] == '+')) {
        negative = s[0] == '-'
        at = 1
    }
    if (at == len(s)) return false
    /* The size of the smallest int, which is one more than the largest. */
    u64 limit = u64(1) << (sizeof(int) * 8 - 1)
    if (!negative) limit--
    u64 total = 0
    for (; at < len(s); at++) {
        int digit = chars.digit_value(s[at])
        if (digit < 0) return false
        /* Checked before it grows, so that it cannot overflow first. */
        if (total > (limit - u64(digit)) / 10) return false
        total = total * 10 + u64(digit)
    }
    *value = negative ? int(0 - total) : int(total)
    return true
}

extern "stdlib.h" {
    f64 strtod(char *text, char **end)
}

// Reads s as a decimal number such as "3", "-2.5", ".5" or "6.02e23".
// Stores it in *value and returns true if all of s is one; returns false,
// leaving *value as it was, otherwise. The form is checked here, and C's
// strtod gives the value nearest to what is written. A number written
// with more than 127 characters is not read.
export bool parse_float(string s, f64 *value) {
    int at = 0
    if (at < len(s) && (s[at] == '-' || s[at] == '+')) at++
    int digits = 0
    while (at < len(s) && chars.is_digit(s[at])) {
        at++
        digits++
    }
    if (at < len(s) && s[at] == '.') {
        at++
        while (at < len(s) && chars.is_digit(s[at])) {
            at++
            digits++
        }
    }
    if (digits == 0) return false
    if (at < len(s) && (s[at] == 'e' || s[at] == 'E')) {
        at++
        if (at < len(s) && (s[at] == '-' || s[at] == '+')) at++
        int exponent_digits = 0
        while (at < len(s) && chars.is_digit(s[at])) {
            at++
            exponent_digits++
        }
        if (exponent_digits == 0) return false
    }
    if (at != len(s) || len(s) > 127) return false
    char text[128]
    for (int i, char c in s) text[i] = c
    text[len(s)] = '\0'
    *value = strtod(&text[0], NULL)
    return true
}
