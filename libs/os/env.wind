// Part of ::os: the environment the program runs in.
#target c

extern "env.h" {
    string os_get_env(string name, bool *set)
    bool os_set_env(string name, string value)
}

// The value of an environment variable, or "" if it is not set. Setting
// the same variable again may end the string this gives.
export string get_env(string name) { return os_get_env(name, NULL) }

// Whether an environment variable is set, even if to "".
export bool has_env(string name) {
    bool set = false
    os_get_env(name, &set)
    return set
}

// Sets an environment variable, which the programs this one runs then see.
export bool set_env(string name, string value) { return os_set_env(name, value) }
