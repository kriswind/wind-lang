// Pointers to functions: written as C writes them, named with typedef, held
// in variables, arrays, maps and fields, passed, compared and called.
typedef int (*BinOp)(int, int)

struct Button {
    string label
    void (*on_click)(string)
}

int add(int a, int b) { return a + b }
int mul(int a, int b) { return a * b }
void shout(string s) { cout << s << "!\n" }

int apply(int (*op)(int, int), int a, int b) { return op(a, b) }

int fold(const int xs[], BinOp op, int start) {
    int acc = start
    for (int x in xs) acc = op(acc, x)
    return acc
}

void each(int xs[..], void (*visit)(int)) {
    for (int x in xs) visit(x)
}

void show(int x) { cout << x << " " }

int main() {
    BinOp op = add
    cout << op(2, 3) << " " << apply(mul, 4, 5) << " " << apply(&add, 1, 1) << "\n"
    op = mul
    int (*same)(int, int) = op
    cout << (*same)(6, 7) << " " << (op == same) << " " << (op != add) << "\n"
    const int xs[] = {1, 2, 3, 4}
    cout << fold(xs, add, 0) << " " << fold(xs, mul, 1) << "\n"
    BinOp table[2] = {add, mul}
    cout << table[1](3, 3) << "\n"
    Button b = {"ok", shout}
    b.on_click(b.label)
    Button *pb = &b
    pb->on_click("again")
    int ys[..] = {7, 8}
    each(ys, show)
    cout << "\n"
    BinOp none = NULL
    if (!none) cout << "none\n"
    BinOp ops[string]
    ops["+"] = add
    cout << ops["+"](10, 5) << "\n"
    return 0
}
