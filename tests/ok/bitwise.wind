/* Bitwise and shift operators. */

const int Width = 1 << 4
int table[Width]

u32 rotate_left(u32 value, int by) {
    return (value << by) | (value >> (32 - by))
}

int main() {
    u8 a = 0xF0
    u8 b = 0x3C
    cout << (a & b) << " " << (a | b) << " " << (a ^ b) << " " << ~a << "\n"

    // Bitwise operators bind tighter than comparisons, unlike in C.
    int x = 6
    if x & 1 == 0 { cout << "even\n" }
    cout << (x & 3 == 2) << " " << (x | 1 > 6) << " " << (1 + 2 << 3) << " " << (x & 3 | 8 ^ 1) << "\n"

    // In cout, "<<" separates values; a shift goes in parentheses.
    cout << x << 2 << " " << (x << 2) << " " << (x >> 1) << " " << table[1 << 2] << len(table) << "\n"

    // Shifts keep the type of the value shifted and never overflow oddly.
    u8 small = 0x81
    i8 negative = -128
    cout << (small << 1) << " " << (small >> 7) << " " << (negative >> 2) << " " << (negative >> 100) << "\n"
    cout << (small << 8) << " " << (small >> 8) << " " << (1 << 64) << " " << (x << -1) << " " << (-1 >> 63) << "\n"

    u64 big = 1
    u8 amount = 63
    cout << (big << amount) << " " << (big << amount >> 62) << "\n"
    i128 huge = 1
    cout << (huge << 100) << " " << (-(huge << 100) >> 99) << " " << (huge << 128) << "\n"
    u128 mask = ~0
    cout << (mask >> 64) << "\n"

    int flags = 0
    flags |= 1 << 3
    flags |= 1
    flags ^= 0xFF
    flags &= ~4
    flags <<= 2
    flags >>= 1
    cout << flags << "\n"

    u8 bytes[3] = {1, 2, 0x80}
    bytes[0] <<= 7
    bytes[1] |= 0xF0
    bytes[-1] >>= 3
    bytes[0] ^= bytes[1] & 0x0F
    cout << bytes << " " << rotate_left(0x80000001, 4) << " " << ~0 << " " << -~x << "\n"

    // The 12-bit big-endian length field used by many binary formats.
    u8 header[2] = {0xA1, 0x2C}
    int length = ((int(header[0]) << 8) | int(header[1])) & 0x0FFF
    cout << length << " " << (header[0] >> 4) << (header[0] & 0x0F) << "\n"
    return 0
}
