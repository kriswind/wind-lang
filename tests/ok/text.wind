// Building text: appending any value to an array of char writes it as
// cout would, and string() views what has been built. left, right and
// fixed give a value a width or a number of digits.

struct Point {
    int x
    int y
}

int noisy() {
    cout << "noisy ran\n"
    return 7
}

int main() {
    char line[..]
    append(line, "took ", 1.5, " s for ", 3, " runs: ", true, ' ', 'x')
    cout << string(line) << "|" << len(line) << "\n"

    char path[..] = clone("build/")
    string name = "wind"
    append(path, name, ".", 42)
    cout << string(path) << "\n"

    int scores[3] = {1, 2, 3}
    int ages[string] = {"ada": 36}
    Point p = {3, 4}
    char all[..]
    append(all, scores, " ", ages, " ", p)
    cout << string(all) << "\n"

    // A value that prints while it is worked out does not print into the
    // text being built.
    char quiet[..]
    append(quiet, "n=", noisy())
    cout << string(quiet) << "\n"

    // Appending the text to itself.
    append(quiet, " ", string(quiet))
    cout << string(quiet) << "\n"

    cout << "[" << left("ab", 5) << "][" << right("ab", 5) << "][" << right(42, 6) << "]\n"
    cout << "[" << fixed(3.14159, 2) << "][" << fixed(2, 3) << "][" << fixed(-0.5, 0)
         << "][" << right(fixed(1.0 / 3.0, 4), 9) << "]\n"
    cout << "[" << left("█▌", 4) << "][" << right(left("x", 2), 4) << "][" << left("toolong", 3)
         << "]\n"

    char table[..]
    string names[2] = {"wind", "c"}
    f64 times[2] = {0.0512, 0.04875}
    for (int i, string n in names) {
        append(table, left(n, 8), right(fixed(times[i], 3), 7), "\n")
    }
    cout << string(table)

    cerr << "to the error output: " << 12 << " " << fixed(2.5, 1) << "\n"
    delete(line)
    delete(path)
    delete(all)
    delete(quiet)
    delete(table)
    delete(ages)
    return 0
}
