// Bodies without braces, as in C.
int classify(int n) {
    if (n < 0) return -1;
    else if (n == 0) return 0;
    else return 1;
}

int sum_to(int n) {
    int total = 0;
    for (int i = 1; i <= n; i++) total += i;
    return total;
}

int main() {
    cout << classify(-5) << " " << classify(0) << " " << classify(9) << "\n"
    cout << sum_to(10) << "\n"

    int i = 0;
    while (i < 3) i++;
    cout << i << "\n"

    do i--; while (i > 0);
    cout << i << "\n"

    // The body may sit on the next line.
    if (i == 0)
        cout << "zero\n"
    else
        cout << "nonzero\n"

    // An else belongs to the nearest if.
    if (i == 0)
        if (i > 5) cout << "big\n"
        else cout << "small\n"

    // Loops nest without braces, and braces mix in freely.
    for (int a = 0; a < 2; a++)
        for (int b = 0; b < 2; b++)
            if (a == b) cout << a << b << " "
            else { cout << "-- " }
    cout << "\n"

    if (i != 0) cout << "skipped\n"; else cout << "one line\n";

    // Parentheses stay optional when the body has braces.
    if i == 0 { cout << "braces\n" } else cout << "unused\n"

    for (;;) break
    return 0;
}
