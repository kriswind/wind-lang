// "s[from:to]" is a view of part of a string: from position from up to,
// not including, position to. Either end may be left out.
int main() {
    string word = "windmill"
    cout << word[0:4] << " " << word[4:] << " " << word[:3] << " " << word[:] << "|\n"
    cout << word[2:2] << "|" << len(word[1:5]) << " " << word[1:5][1] << "\n"
    int cut = 3
    cout << word[cut:cut + 2] << " " << word[len(word) - 4:] << "\n"
    string greeting = "hi there"
    cout << (greeting[0:2] == "hi") << " " << ("wind"[1:3]) << "\n"
    return 0
}
