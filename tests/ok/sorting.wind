// Strings compare byte by byte; sort puts an array in order, keeping equal
// elements in the order they were in, and reverse turns it around.

enum Size { SMALL, MEDIUM, LARGE }

struct Result {
    string name
    f64 seconds
    int runs
}

int main() {
    cout << ("apple" < "banana") << ("app" < "apple") << ("b" > "apple") << ("" < "a") << "\n"

    int numbers[..] = {5, 3, 9, 1, 5, 7}
    sort(numbers)
    cout << numbers << "\n"
    reverse(numbers)
    cout << numbers << "\n"

    string names[5] = {"pear", "Apple", "fig", "apple", "banana"}
    sort(names)
    cout << names << "\n"

    f64 times[4] = {0.5, -1.25, 3, 0}
    sort(times)
    cout << times << "\n"

    Size sizes[..] = {LARGE, SMALL, MEDIUM, SMALL}
    sort(sizes)
    cout << sizes << "\n"

    // Sorting rows by one field keeps rows with equal keys in their order.
    Result rows[..]
    append(rows, {"go", 0.07, 3}, {"c", 0.05, 1}, {"rust", 0.07, 2}, {"wind", 0.05, 4})
    sort(rows, .seconds)
    for (Result r in rows) cout << r.name << " "
    cout << "\n"
    sort(rows, .name)
    for (Result r in rows) cout << r.name << " "
    cout << "\n"
    sort(rows, .runs)
    reverse(rows)
    for (Result r in rows) cout << r.runs << " "
    cout << "\n"

    char empty[..]
    sort(empty)
    reverse(empty)
    cout << len(empty) << "\n"

    int many[1000]
    for (int i = 0; i < 1000; i++) many[i] = (i * 7919) % 1000
    sort(many)
    bool ordered = true
    for (int i = 1; i < 1000; i++) ordered = ordered && many[i - 1] <= many[i]
    cout << ordered << " " << many[0] << " " << many[999] << "\n"
    delete(numbers)
    delete(sizes)
    delete(rows)
    return 0
}
