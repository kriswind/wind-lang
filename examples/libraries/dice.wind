// Throws two dice six thousand times and draws how often each total came
// up, then shuffles a hand of cards, using ::random. The seed is fixed, so
// every run gives the same throws; change it for others.

import ::random

const int THROWS = 6000

int main() {
    random.seed(2026)

    // counts[t] is how often the dice came to t; 2 to 12 are used.
    int counts[13]
    for (int i = 0; i < THROWS; i++) {
        counts[random.range(1, 7) + random.range(1, 7)]++
    }
    cout << THROWS << " throws of two dice:\n"
    for (int total = 2; total <= 12; total++) {
        if (total < 10) cout << " "
        cout << total << " "
        for (int bar = 0; bar < counts[total] / 25; bar++) cout << "#"
        cout << " " << counts[total] << "\n"
    }

    int hand[8] = {1, 2, 3, 4, 5, 6, 7, 8}
    random.shuffle(hand)
    cout << "\nshuffled: " << hand << "\n"
    cout << "a coin: " << (random.chance(50) ? "heads" : "tails") << "\n"
    return 0
}
